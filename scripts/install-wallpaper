#!/usr/bin/env bash
# Builds the Ripples live wallpaper and installs it to ~/Applications/Ripples.app.
#   scripts/install-wallpaper            build, install, start
#   scripts/install-wallpaper --login    also start it at every login
#   scripts/install-wallpaper --remove   stop it, remove the login item and the app
set -euo pipefail
cd "$(dirname "$0")/.."
id=io.github.soumyadip-clueso.ripples
app="$HOME/Applications/Ripples.app"
agent="$HOME/Library/LaunchAgents/$id.plist"

stop() {
  launchctl bootout "gui/$(id -u)/$id" 2>/dev/null || true
  pkill -x Ripples 2>/dev/null || true
}

if [[ "${1:-}" == "--remove" ]]; then
  stop; rm -rf "$app" "$agent"; echo "Ripples removed."; exit 0
fi

out=target/wallpaper/Ripples.app
rm -rf "$out"; mkdir -p "$out/Contents/MacOS" "$out/Contents/Resources/ripples"
swiftc -O -o "$out/Contents/MacOS/Ripples" extras/wallpaper/Ripples.swift -framework AppKit -framework WebKit
cp assets/ripples.js "$out/Contents/Resources/ripples/ripples.js"
# The page beside its script, at 30 fps: a wallpaper should sip the battery.
sed -e 's#src="../../assets/ripples.js"#src="ripples.js"#' -e "s#q.get('fps') || 60#q.get('fps') || 30#" extras/ripples/index.html > "$out/Contents/Resources/ripples/index.html"
cat > "$out/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>Ripples</string>
  <key>CFBundleIdentifier</key><string>$id</string>
  <key>CFBundleExecutable</key><string>Ripples</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.1.0</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>LSUIElement</key><true/>
</dict></plist>
PLIST
codesign -s - --force --deep "$out" >/dev/null 2>&1
stop
mkdir -p "$HOME/Applications"; rm -rf "$app"; cp -R "$out" "$app"

if [[ "${1:-}" == "--login" ]]; then
  mkdir -p "$(dirname "$agent")"
  cat > "$agent" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$id</string>
  <key>ProgramArguments</key><array><string>$app/Contents/MacOS/Ripples</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>ProcessType</key><string>Interactive</string>
</dict></plist>
PLIST
  launchctl bootstrap "gui/$(id -u)" "$agent"
  echo "Ripples starts at login (remove with --remove)."
else
  open "$app"
fi
echo "$app"
